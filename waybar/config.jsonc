{
    "layer": "top",
    "position": "top",
    "exclusive": false,
    "height": 30,
    "spacing": 4,

    "modules-left": ["cpu", "memory", "custom/gpu", "network"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "pulseaudio", "custom/power",  ],

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "RAM {percentage}%",
        "tooltip-format": "{used} / {total}GiB",
        "interval": 2
    },

    "custom/gpu": {
        "exec": "/home/rp34/.config/waybar/scripts/gpu_usage.sh",
        "interval": 2,
        "format": "GPU {}%",
        "tooltip-format": "{}%"
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": " Wired",
        "format-disconnected": " Disconnected",
        "tooltip-format": "↓ {bandwidthDownBytes} ↑ {bandwidthUpBytes}\n{frequency} MHz"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "mpris": {
        "format": "{title} - {artist}",
        "format-paused": "{title} - {artist}",
        "max-length": 50,
        "tooltip-format": "Now Playing: {title} — {artist}",
        "interval": 2
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout -b 6 -m 470 -c 15"
    }
}
