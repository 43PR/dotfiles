/* Generated by 43pr theme.py from ~/.config/43pr/templates/rofi-colors.rasi. Do not edit. */
* {
    bg:          {{bg|alpha=70}};
    border-color: {{border_strong}};
    bg-alt:      {{bg|alpha=00}};
    bg-hover:    {{bg_hover|alpha=ff}};
    bg-selected: {{accent|alpha=00}};
    fg:          {{fg_soft|alpha=ff}};
    fg-muted:    {{fg_muted|alpha=ff}};
    fg-dark:     {{fg_dark}};
    fg-selected: {{fg}};
    accent:      {{highlight|alpha=ff}};
    accent-soft: {{highlight|alpha=33}};
    urgent:      {{urgent|alpha=ff}};
}
