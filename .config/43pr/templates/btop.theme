# Generated by 43pr theme.py from ~/.config/43pr/templates/btop.theme. Do not edit.
# Colors come from the shared semantic palette (presets or Matugen).

# Main background, empty = use terminal default (needed for transparency)
theme[main_bg]="{{bg}}"

# Main text color
theme[main_fg]="{{fg_soft}}"

# Title color for boxes
theme[title]="{{fg}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{accent}}"

# Background and foreground color for selected item in processes box
theme[selected_bg]="{{bg_hover}}"
theme[selected_fg]="{{fg}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{fg_faint}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{highlight}}"

# Box outline and divider line colors
theme[cpu_box]="{{border_accent}}"
theme[mem_box]="{{border_accent}}"
theme[net_box]="{{border_accent}}"
theme[proc_box]="{{border_accent}}"
theme[div_line]="{{border_accent}}"

# Temperature graph colors
theme[temp_start]="{{fg_muted}}"
theme[temp_mid]="{{urgent}}"
theme[temp_end]="{{danger}}"

# CPU graph colors
theme[cpu_start]="{{fg_dark}}"
theme[cpu_mid]="{{fg_dim}}"
theme[cpu_end]="{{accent}}"

# Mem/Disk free meter
theme[free_start]="{{fg_dark}}"
theme[free_mid]="{{fg_muted}}"
theme[free_end]="{{ok}}"

# Mem/Disk cached meter
theme[cached_start]="{{fg_dark}}"
theme[cached_mid]="{{fg_muted}}"
theme[cached_end]="{{highlight}}"

# Mem/Disk available meter
theme[available_start]="{{fg_dark}}"
theme[available_mid]="{{fg_muted}}"
theme[available_end]="{{fg_dim}}"

# Mem/Disk used meter
theme[used_start]="{{fg_dark}}"
theme[used_mid]="{{fg_dim}}"
theme[used_end]="{{accent}}"

# Download graph colors
theme[download_start]="{{fg_dark}}"
theme[download_mid]="{{fg_muted}}"
theme[download_end]="{{highlight}}"

# Upload graph colors
theme[upload_start]="{{fg_dark}}"
theme[upload_mid]="{{fg_muted}}"
theme[upload_end]="{{accent}}"
