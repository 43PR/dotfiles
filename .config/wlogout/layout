{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "S",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "R",
    "keybind" : "r"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Z",
    "keybind" : "z"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch 'hl.dsp.exit()'",
    "text" : "E",
    "keybind" : "e"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "H",
    "keybind" : "h"
}

